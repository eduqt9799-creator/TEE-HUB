# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. Supabase, Neon, Render, Cloud SQL)
DATABASE_URL="postgresql://user:password@localhost:5432/teehub?schema=public"

# SESSION_SECRET: Secret key for server session and cookie signing
SESSION_SECRET="your-secure-random-32-byte-session-secret"

# FRONTEND_URL: Production origin of the frontend (for CORS and webhook redirects)
FRONTEND_URL="https://teehub.in"

# RAZORPAY CONFIGURATION (Get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# CLOUDINARY IMAGE STORAGE (Get from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# PORT: Server port (defaults to 3000)
PORT="3000"

